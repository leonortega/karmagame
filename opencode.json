{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "godot-mcp-toolkit": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@npgamedev/godot-mcp-server@1.1.0"],
      "environment": {
        "GODOT_MCP_CONFIG_VERSION": "1",
        "npm_config_prefer_offline": "true"
      }
    }
  },
  "skills": {
    "paths": [".opencode/node_modules/opencode-godot-toolkit/skills"]
  },
  "instructions": [".opencode/node_modules/opencode-godot-toolkit/rules/godot.md"],
  "lsp": {
    "gdscript": {
      "command": ["node", ".opencode/node_modules/opencode-godot-toolkit/dist/godot-lsp-bridge.js"],
      "extensions": [".gd"]
    }
  }
}