{
  "mcpServers": {
    "godot-mcp-toolkit": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@npgamedev/godot-mcp-server@1.1.0"],
      "env": {
        "GODOT_MCP_CONFIG_VERSION": "1",
        "npm_config_prefer_offline": "true"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}